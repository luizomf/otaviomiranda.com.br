---
/** A distraction-free, client-side Markdown workspace. No site-wide styles. */
import BlankLayout from '../layouts/BlankLayout.astro';
import '../styles/fonts.css';

const editorSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Markdown Editor',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  description:
    'Editor Markdown com Monaco, Vim mode e preview em tempo real no navegador.',
  url: 'https://otaviomiranda.com.br/editor/',
  author: { '@type': 'Person', name: 'Otávio Miranda' },
};
---

<BlankLayout
  title='Markdown Editor com Vim e Preview ao Vivo | Otávio Miranda'
  description='Editor Markdown gratuito com Monaco Editor, Vim motions, busca com regex e preview ao vivo. Abra, edite e salve arquivos .md direto no navegador.'
>
  <script
    is:inline
    type='application/ld+json'
    set:html={JSON.stringify(editorSchema)}
  />
  <main
    class='editor-shell'
    data-layout='split'
    lang='en'
    aria-label='Markdown workspace'
  >
    <header class='editor-toolbar'>
      <a class='editor-brand' href='/' aria-label='Otávio Miranda home'
        >M<span>↓</span></a
      >
      <div class='editor-document'>
        <h1 id='editor-file'>untitled.md</h1>
        <span class='editor-subtitle'>Markdown workspace</span>
      </div>
      <div class='editor-layouts' role='group' aria-label='Workspace layout'>
        <button
          type='button'
          data-layout='code'
          aria-label='Editor only'
          aria-pressed='false'
          title='Editor only'
        >
          <svg viewBox='0 0 20 20' aria-hidden='true'
            ><rect x='2.5' y='3.5' width='15' height='13' rx='2'></rect><path
              d='m8 7-3 3 3 3m4-6 3 3-3 3'></path></svg
          >
          <span>Write</span>
        </button>
        <button
          type='button'
          data-layout='split'
          aria-label='Split view'
          aria-pressed='true'
          title='Split view'
        >
          <svg viewBox='0 0 20 20' aria-hidden='true'
            ><rect x='2.5' y='3.5' width='15' height='13' rx='2'></rect><path
              d='M10 4v12'></path></svg
          >
          <span>Split</span>
        </button>
        <button
          type='button'
          data-layout='preview'
          aria-label='Preview only'
          aria-pressed='false'
          title='Preview only'
        >
          <svg viewBox='0 0 20 20' aria-hidden='true'
            ><path d='M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z'></path><circle
              cx='10'
              cy='10'
              r='2'></circle></svg
          >
          <span>Read</span>
        </button>
      </div>
      <button
        id='editor-save'
        class='editor-save'
        type='button'
        title='Save (⌘/Ctrl+S)'
        disabled>Save</button
      >
      <div class='editor-menu-container'>
        <button
          id='editor-menu-toggle'
          class='editor-menu-toggle'
          type='button'
          aria-label='Editor menu'
          aria-expanded='false'
          aria-controls='editor-menu'
        >
          <svg viewBox='0 0 20 20' aria-hidden='true'
            ><path d='M3 5h14M3 10h14M3 15h14'></path></svg
          >
        </button>
        <div id='editor-menu' class='editor-menu' hidden>
          <p class='editor-menu-label'>Document</p>
          <button id='editor-new' type='button' disabled>New document</button>
          <button id='editor-open' type='button' disabled
            >Open file <kbd>⌘/Ctrl O</kbd></button
          >
          <button id='editor-save-as' type='button' disabled
            >Save as… <kbd>⇧ ⌘/Ctrl S</kbd></button
          >
          <button id='editor-frontmatter' type='button' disabled
            >Insert frontmatter</button
          >
          <hr />
          <p class='editor-menu-label'>Workspace</p>
          <button id='editor-zen' type='button' aria-pressed='false' disabled
            >Zen mode <kbd>Esc to exit</kbd></button
          >
          <button id='editor-wrap' type='button' aria-pressed='false' disabled
            >Word wrap <span class='editor-setting-state'>Off</span></button
          >
          <button
            id='editor-vim-toggle'
            type='button'
            aria-pressed='false'
            disabled
            >Vim mode <span class='editor-setting-state'>Off</span></button
          >
          <button id='editor-sync' type='button' aria-pressed='true' disabled
            >Sync scrolling <span class='editor-setting-state'>On</span></button
          >
          <button
            id='editor-preview-theme'
            type='button'
            aria-pressed='false'
            disabled
            >Dark preview <span class='editor-setting-state'>Off</span></button
          >
          <p class='editor-menu-hint'>
            Drop a .md, .markdown or .txt file anywhere to open it. Files stay
            in your browser; embedded images may load remotely.
          </p>
        </div>
      </div>
    </header>

    <div class='editor-panes'>
      <section
        class='editor-pane editor-pane--code'
        aria-label='Markdown source'
      >
        <div class='editor-pane-heading'>
          <span>MARKDOWN</span><span id='editor-vim-status'>Vim off</span>
        </div>
        <div id='editor-monaco' class='editor-monaco'></div>
      </section>
      <div
        id='editor-divider'
        class='editor-divider'
        role='separator'
        tabindex='0'
        aria-label='Resize editor and preview'
        aria-controls='editor-monaco editor-preview'
        aria-orientation='vertical'
        aria-valuemin='20'
        aria-valuemax='80'
        aria-valuenow='50'
        title='Drag to resize · Double-click to reset'
      >
      </div>
      <section
        class='editor-pane editor-pane--preview'
        aria-label='Rendered preview'
        data-theme='light'
      >
        <div class='editor-pane-heading'>
          <span>PREVIEW</span><span>Rendered locally</span>
        </div>
        <article
          id='editor-preview'
          class='editor-preview'
          tabindex='0'
          aria-label='Markdown preview'
        >
        </article>
      </section>
    </div>
    <footer class='editor-statusbar'>
      <span id='editor-status' role='status' aria-live='polite'
        >Loading editor…</span
      >
      <span id='editor-stats'>Markdown · UTF-8</span>
    </footer>
    <button
      id='editor-zen-exit'
      class='editor-zen-exit'
      type='button'
      aria-label='Exit zen mode'
      title='Exit zen mode (Esc)'
      hidden>↗ <span>Exit zen</span></button
    >
    <div
      id='editor-drop-overlay'
      class='editor-drop-overlay'
      hidden
      aria-hidden='true'
    >
      <div>
        <strong>Drop to open</strong><span>One Markdown or text file</span>
      </div>
    </div>
  </main>
  <input
    id='editor-open-input'
    type='file'
    hidden
    accept='.md,.markdown,.txt,text/markdown,text/plain'
  />
  <script
    is:inline
    src='https://cdn.jsdelivr.net/npm/monaco-editor@0.56.0/min/vs/loader.js'
  ></script>
  <script>
    import '../scripts/editor/index.js';
  </script>
</BlankLayout>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
    background: #15181e;
  }
  .editor-shell,
  .editor-shell * {
    box-sizing: border-box;
  }
  .editor-shell {
    --surface: #1c2028;
    --border: #303641;
    --muted: #9ca8b9;
    --accent: #c3dfa0;
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    color: #e4e9f0;
    font:
      13px/1.5 system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }
  .editor-shell [hidden] {
    display: none !important;
  }
  button {
    font: inherit;
    cursor: pointer;
    color: inherit;
  }
  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  button:focus-visible,
  a:focus-visible,
  article:focus-visible {
    outline: 2px solid #c3dfa0;
    outline-offset: -3px;
  }
  button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    background: #15181e;
    z-index: 10;
  }
  .editor-brand {
    font:
      800 22px/1 ui-monospace,
      monospace;
    letter-spacing: -3px;
    text-decoration: none;
    color: var(--accent);
    padding: 8px 10px 8px 0;
  }
  .editor-brand span {
    font-weight: 400;
  }
  .editor-document {
    flex: 1;
    min-width: 0;
  }
  .editor-document h1 {
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .editor-subtitle {
    color: var(--muted);
    font-size: 11px;
  }
  .editor-layouts {
    display: flex;
    padding: 3px;
    border: 1px solid var(--border);
    background: #0f1217;
    border-radius: 8px;
    gap: 2px;
  }
  .editor-layouts button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: var(--muted);
    border-radius: 5px;
    padding: 6px 11px;
    min-height: 32px;
  }
  .editor-layouts button[aria-pressed='true'] {
    background: #303742;
    color: #f4f6fa;
    box-shadow: 0 1px 3px #0004;
  }
  .editor-layouts button:hover {
    color: #fff;
  }
  .editor-save {
    background: var(--accent);
    color: #1d2c17;
    border: 0;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 650;
  }
  .editor-save:hover {
    background: #d6edba;
  }
  .editor-menu-container {
    position: relative;
  }
  .editor-menu-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
  }
  .editor-menu-toggle:hover,
  .editor-menu-toggle[aria-expanded='true'] {
    background: #303742;
  }
  .editor-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: min(300px, calc(100vw - 24px));
    max-height: calc(100dvh - 90px);
    overflow: auto;
    padding: 8px;
    background: #1c2028;
    border: 1px solid #3c4350;
    border-radius: 10px;
    box-shadow: 0 16px 50px #0006;
  }
  .editor-menu-label {
    margin: 8px 10px 5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 10px;
    font-weight: 700;
    color: var(--muted);
  }
  .editor-menu button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    padding: 9px 10px;
    background: transparent;
    border: 0;
    border-radius: 5px;
    gap: 12px;
  }
  .editor-menu button:hover {
    background: #303742;
  }
  .editor-menu kbd {
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
  }
  .editor-setting-state {
    font-size: 11px;
    color: var(--muted);
  }
  .editor-menu button[aria-pressed='true'] .editor-setting-state {
    color: var(--accent);
  }
  .editor-menu hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 8px 2px;
  }
  .editor-menu-hint {
    font-size: 11px;
    line-height: 1.6;
    color: var(--muted);
    margin: 12px 10px 6px;
  }
  .editor-panes {
    --code-size: 1fr;
    --preview-size: 1fr;
    display: grid;
    grid-template-columns: minmax(0, var(--code-size, 1fr)) 7px minmax(
        0,
        var(--preview-size, 1fr)
      );
    min-height: 0;
  }
  .editor-divider {
    position: relative;
    cursor: col-resize;
    background: #15181e;
    touch-action: none;
    outline: none;
  }
  .editor-divider::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 36px;
    top: calc(50% - 18px);
    left: 2px;
    border-radius: 2px;
    background: #657084;
  }
  .editor-divider:hover,
  .editor-divider:focus-visible,
  [data-resizing='true'] .editor-divider {
    background: #45543b;
  }
  .editor-divider:focus-visible::after {
    background: var(--accent);
  }
  [data-resizing='true'] {
    user-select: none;
  }
  .editor-shell:not([data-layout='split']) .editor-divider {
    display: none;
  }
  .editor-shell:not([data-layout='split']) .editor-panes {
    grid-template-columns: minmax(0, 1fr);
  }
  .editor-pane {
    display: grid;
    grid-template-rows: 35px minmax(0, 1fr);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .editor-pane--code {
    background: #1c2028;
  }
  .editor-pane--preview {
    border-left: 0;
  }
  .editor-pane-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    background: #1c2028;
    border-bottom: 1px solid var(--border);
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  #editor-vim-status {
    letter-spacing: 0;
    min-width: 0;
  }
  #editor-vim-status :global(input) {
    width: min(280px, 45vw);
    padding: 3px 6px;
    border: 1px solid #657084;
    border-radius: 3px;
    background: #15181e;
    color: #e4e9f0;
    font:
      12px ui-monospace,
      monospace;
  }
  .editor-monaco {
    min-width: 0;
    height: 100%;
  }
  .editor-preview {
    --paper: #fbfaf7;
    --ink: #30343b;
    --subtle: #656c76;
    --rule: #ddded9;
    --tint: #eeeee8;
    --link: #25634b;
    margin: 0;
    overflow: auto;
    min-width: 0;
    background: var(--paper);
    color: var(--ink);
    padding: 40px max(32px, calc((100% - 760px) / 2)) 80px;
    font-size: 16px;
    line-height: 1.8;
    overflow-wrap: anywhere;
    color-scheme: light;
    scrollbar-gutter: stable;
  }
  [data-theme='dark'] .editor-preview {
    --paper: #20242b;
    --ink: #d8dce3;
    --subtle: #a7b0bd;
    --rule: #3a414c;
    --tint: #2b313a;
    --link: #bedc9d;
    color-scheme: dark;
  }
  .editor-preview :global(*),
  .editor-preview :global(*::before),
  .editor-preview :global(*::after) {
    box-sizing: border-box;
  }
  .editor-preview :global(> :first-child) {
    margin-top: 0;
  }
  .editor-preview :global(h1),
  .editor-preview :global(h2),
  .editor-preview :global(h3),
  .editor-preview :global(h4),
  .editor-preview :global(h5),
  .editor-preview :global(h6) {
    color: var(--ink);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 1.8em 0 0.65em;
  }
  .editor-preview :global(h1) {
    font-size: 2.15em;
    margin-bottom: 0.8em;
    letter-spacing: -0.04em;
  }
  .editor-preview :global(h2) {
    font-size: 1.5em;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4em;
  }
  .editor-preview :global(h3) {
    font-size: 1.2em;
  }
  .editor-preview :global(h4) {
    font-size: 1.05em;
  }
  .editor-preview :global(h5),
  .editor-preview :global(h6) {
    font-size: 1em;
  }
  .editor-preview :global(p),
  .editor-preview :global(ul),
  .editor-preview :global(ol),
  .editor-preview :global(dl) {
    margin: 0 0 1.15em;
  }
  .editor-preview :global(ul),
  .editor-preview :global(ol) {
    padding-left: 1.5em;
  }
  .editor-preview :global(li) {
    padding-left: 0.2em;
    margin: 0.3em 0;
  }
  .editor-preview :global(li > ul),
  .editor-preview :global(li > ol) {
    margin-block: 0.35em;
  }
  .editor-preview :global(li > p) {
    margin-bottom: 0.4em;
  }
  .editor-preview :global(li::marker) {
    color: var(--subtle);
  }
  .editor-preview :global(blockquote) {
    margin: 1.5em 0;
    border-left: 3px solid #86a773;
    padding: 0.7em 1.2em;
    background: var(--tint);
    color: var(--subtle);
    border-radius: 0 6px 6px 0;
  }
  .editor-preview :global(blockquote > :last-child) {
    margin-bottom: 0;
  }
  .editor-preview :global(a) {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .editor-preview :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .editor-preview :global(code),
  .editor-preview :global(kbd),
  .editor-preview :global(samp) {
    font-family: 'FiraMono Nerd Font', 'SFMono-Regular', Consolas, monospace;
    font-variant-ligatures: none;
    font-feature-settings:
      'liga' 0,
      'calt' 0,
      'dlig' 0;
    font-size: 0.86em;
  }
  .editor-preview :global(:not(pre) > code) {
    background: var(--tint);
    padding: 0.18em 0.38em;
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-decoration-break: clone;
  }
  .editor-preview :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    background: #24292e;
    color: #e1e4e8;
    padding: 20px;
    margin: 1.5em 0;
    border: 1px solid #3a414c;
    border-radius: 8px;
    line-height: 1.65;
    tab-size: 2;
    overflow-wrap: normal;
  }
  .editor-preview :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 13px;
  }
  .editor-preview :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.92em;
  }
  .editor-preview :global(th),
  .editor-preview :global(td) {
    padding: 0.65em 1em;
    border: 1px solid var(--rule);
    text-align: left;
  }
  .editor-preview :global([align='center']) {
    text-align: center;
  }
  .editor-preview :global([align='right']) {
    text-align: right;
  }
  .editor-preview :global(th) {
    background: var(--tint);
    font-weight: 650;
  }
  .editor-preview :global(tr:nth-child(even)) {
    background: var(--tint);
  }
  .editor-preview :global(img),
  .editor-preview :global(video) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .editor-preview :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2em 0;
  }
  .editor-preview :global(input[type='checkbox']) {
    accent-color: #60804f;
    margin-right: 0.5em;
  }
  .editor-preview :global(details) {
    border: 1px solid var(--rule);
    padding: 0.8em 1em;
    margin: 1.2em 0;
    border-radius: 6px;
  }
  .editor-preview :global(summary) {
    cursor: pointer;
    font-weight: 600;
  }
  .editor-preview :global(details[open] > summary) {
    margin-bottom: 0.8em;
  }
  .editor-preview :global(kbd) {
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.15em 0.4em;
  }
  .editor-preview :global(dt) {
    font-weight: 650;
  }
  .editor-preview :global(dd) {
    margin-left: 1.5em;
    margin-bottom: 0.6em;
  }
  .editor-statusbar {
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 5px 20px;
    background: #15181e;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
  }
  #editor-status[data-error='true'] {
    color: #ffaaa0;
  }
  #editor-stats {
    white-space: nowrap;
  }
  .editor-shell[data-zen='true'] {
    grid-template-rows: minmax(0, 1fr);
  }
  .editor-shell[data-zen='true'] .editor-toolbar,
  .editor-shell[data-zen='true'] .editor-statusbar,
  .editor-shell[data-zen='true'] .editor-pane-heading {
    display: none;
  }
  .editor-shell[data-zen='true'] .editor-pane {
    grid-template-rows: minmax(0, 1fr);
  }
  /* Vim needs a focusable command host even when persistent chrome is hidden. */
  .editor-shell[data-zen='true'] .editor-pane-heading:has(input) {
    display: block;
    position: fixed;
    bottom: 12px;
    left: 12px;
    z-index: 30;
    max-width: calc(100vw - 125px);
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .editor-shell[data-zen='true']
    .editor-pane-heading:has(input)
    > span:first-child {
    display: none;
  }
  .editor-zen-exit {
    position: fixed;
    bottom: 12px;
    right: 16px;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: 1px solid #78849380;
    border-radius: 6px;
    background: #20242be8;
    color: #e4e9f0;
    font-size: 11px;
    opacity: 0.65;
  }
  .editor-zen-exit:hover,
  .editor-zen-exit:focus-visible {
    opacity: 1;
  }
  .editor-drop-overlay {
    position: absolute;
    inset: 76px 12px 40px;
    z-index: 20;
    display: grid;
    place-items: center;
    background: #15181eed;
    border: 2px dashed var(--accent);
    border-radius: 12px;
    pointer-events: none;
